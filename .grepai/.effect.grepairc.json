{
  "$schema": "../packages/core/src/grepai-config-schema.json",
  "storage": {
    "type": "lancedb"
  },
  "embedding": {
    "provider": "google",
    "model": "gemini-embedding-001",
    "apiKey": "${GEMINI_API_KEY}",
    "dimensions": 3072,
    "maxChunkSize": 1024,
    "targetChunkSize": 512,
    "tokenizer": "simple"
  },
  "cwd": "../opensource",
  "include": ["effect/packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "effect/packages/platform/src/internal/httpApiScalar.ts",
    "effect/packages/platform/src/internal/httpApiSwagger.ts"
  ]
}
